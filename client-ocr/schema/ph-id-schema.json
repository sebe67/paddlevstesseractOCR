{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ph id schema",
  "description": "schema for OCR data from IDs",
  "type": "object",
  "$defs": {
    "OcrField": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "description": "The normalized, extracted text"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_side": {
          "type": "string",
          "enum": ["FRONT", "BACK"]
        },
        "bounding_box": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": ["value", "confidence"]
    }
  },
  "properties": {
    "id_type": {
      "type": "string",
      "enum": [
        "PHILSYS", "UMID", "DRIVERS_LICENSE", "PASSPORT", "PRC",
        "POSTAL", "VOTERS", "SSS", "TIN", "PHILHEALTH",
        "SENIOR_CITIZEN", "PWD"
      ]
    },
    "common_fields": {
      "type": "object",
      "properties": {
        "last_name": { "$ref": "#/$defs/OcrField" },
        "first_name": { "$ref": "#/$defs/OcrField" },
        "middle_name": { "$ref": "#/$defs/OcrField" },
        "name_extension": { "$ref": "#/$defs/OcrField" },
        "date_of_birth": { "$ref": "#/$defs/OcrField" },
        "sex": { "$ref": "#/$defs/OcrField" },
        "address": { "$ref": "#/$defs/OcrField" },
        "blood_type": { "$ref": "#/$defs/OcrField" }
      },
      "required": ["first_name", "last_name", "date_of_birth"]
    },
    "variant_fields": {
      "type": "object",
      "description": "Fields that only appear on specific ID types",
      "properties": {
        "id_number": {
          "$ref": "#/$defs/OcrField",
          "description": "Generic ID number field"
        },
        "issue_date": { "$ref": "#/$defs/OcrField" },
        "expiry_date": { "$ref": "#/$defs/OcrField" },
        "place_of_birth": { "$ref": "#/$defs/OcrField" },
        "civil_status": { "$ref": "#/$defs/OcrField" },
        "nationality": { "$ref": "#/$defs/OcrField" },
        "weight": { "$ref": "#/$defs/OcrField" },
        "height": { "$ref": "#/$defs/OcrField" },
        "emergency_contact": { "$ref": "#/$defs/OcrField" },
        "license_restrictions": { "$ref": "#/$defs/OcrField" },
        "prc_profession": { "$ref": "#/$defs/OcrField" },
        "pwd_disability_type": { "$ref": "#/$defs/OcrField" }
      }
    },
    "document_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "side": { "type": "string", "enum": ["FRONT", "BACK"] },
          "image_hash": { "type": "string" },
          "raw_ocr_text": { "type": "string" },
          "engine_version": { "type": "string" }
        }
      }
    }
  },
  "required": ["common_fields"]
}
